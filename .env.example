NEXT_PUBLIC_BASE_PATH=/human-made-live

# Comma-separated PeerJS IDs for live room discovery.
NEXT_PUBLIC_DIRECTORY_PEERS=

# Comma-separated PeerJS IDs for persistent PeerDB nodes.
NEXT_PUBLIC_PEERDB_PEERS=

# Public URL for the auth-peer HTTP gateway.
NEXT_PUBLIC_AUTH_PEER_URL=

# Google Identity Services OAuth web client ID. Safe to expose in browser code.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
